    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python: open api",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "cwd" : "${fileDirname}",
            "console": "internalConsole",
            "args" : [
                "--debug",
                "--printlog",                
                "--port", "7000",
                "--open_api",
                //"--host", "127.0.0.1",
                // "--api_root_path", "/openapi",

                //"--dummy",
                //"--script_config", "./config/subconfig/global.json"
            ]
        },

        {
            "name": "Python: aivax testcase",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "cwd" : "${fileDirname}",
            "console": "internalConsole",
            "args" : [
                "--debug",
                "--printlog",                
                "-f", "local_resource/script_config/aivax/rdb_restore.json",
                "--api_print_console", "1"
                //"--host", "127.0.0.1",
                // "--api_root_path", "/openapi",

                //"--dummy",
                //"--script_config", "./config/subconfig/global.json"
            ]
        },

    ]
}

