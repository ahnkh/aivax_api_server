                "mariadb_port" : 3306,
                "mariadb_database" : "app",
                "mariadb_user" : "app",
                "mariadb_password" : "app"
            },

            "opensearch":
            {
                "opensearch_host" : "127.0.0.1",
                "opensearch_port" : 9200,
                "opensearch_id" : "admin",
                "opensearch_password" : "Sniper123!@#",

                "opensearch_data_root" : "/data/opensearch",
                "opensearch_snapshot_root" : "/data/backup/opensearch_snapshot"
            }
            
        }
        
    },

    "aivax_install_module":
    {
        "local_instance_module_map":
        {
            "aivax_install":
            {

                "default_module_path" : "util_modules.wins_manage_modules.ext_aivax_install_modules",

                "aivax_factory_install":
                {
                    "package" : "command_factory_install.aivax_factory_install_command",
                    "class" : "AivaxFactoryInstallCommand",
                    "method" : "RunCommand"
                },

                "aivax_install_dialog_menu":
                {
                    "package" : "command_install_dialog.aivax_install_dialog_ui_command",
                    "class" : "AivaxInstallDialogUICommand",
                    "method" : "RunCommand"
                },

                "aivax_install_util":
                {
                    "package" : "command_install_util_module.aivax_install_util_command",
                    "class" : "AivaxInstallUtilCommand",
                    "method" : "RunCommand"
                },

                "aivax_process":
                {
                    "package" : "command_install_util_module.aivax_process_manage_command",
                    "class" : "AivaxProcessManageCommand",
                    "method" : "RunCommand"
                }

            }
        },

        "aivax_factory_install":
        {
            "comment" : "install enable flag는 실행 옵션, dialog 및 외부 config에서 관리",

            "directory_install":
            {
                "aivax_old_postfix" : ".old",

                "aivax_directory_list": [
                    "extension",
                    "data_resource",
                    "data_resource/attach_file",
                    "data_resource/policy_signal"
                ],

                "ext_directory_list" : [
                    "/home1/install/extension/rpm-repo",
                    "/data/backup/opensearch_snapshot",
                    "/data/backup/attach_file_backup",
                    "/data/backup/prompt_log_backup"
                ],

                "custom_file_install_list" : [
                    {
                        "desc" : "aivax policy file copy",
                        "source_file" : "data-setup/etc-resource/aivax_policy.json",
                        "desc_dir" : "{aivax_install_root}/data_resource/policy_signal/"
                    },
                    {
                        "desc" : "aivax policy file copy",
                        "source_file" : "data-setup/etc-resource/block.html",
                        "desc_dir" : "{aivax_install_root}/data_resource/"
                    },

                    {
                        "desc" : "aivax multi license file copy",
                        "source_file" : "data-setup/license/multi_licenses_crypt",
                        "use_chmod" : true,
                        "desc_dir" : "/usr/local/bin/"
                    },

                    {
                        "desc" : "aivax license_v2 file copy",
                        "source_file" : "data-setup/license/license_key_v2",
                        "use_chmod" : true,
                        "desc_dir" : "/usr/local/bin/"
                    }
                ]

            },

            "os_env_install":
            {
                "comment" : "OS, 시스템 환경 설정 관련, 아직 미구현"
            },

            "rpm_install":
            {
                "yum.repo_conf":
                {
                    "yum.repo_path" : "/etc/yum.repos.d/",
                    "yum.backup_path" : "/etc/yum.repos.d_bak/",

                    "aivax.yum_repo" : "{package_root}/extension/rpm-install/aivax.repo"
                },

                "rpm_repository":
                {
                    "aivax_rpm_extension_repository" : "/home1/install/extension/rpm-repo/",

                    "aivax_rpm_repo_directory_list": [

                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/base-repo", "desc" : "기본 rpm"},
                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/libreoffice-full"},
                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/tesseract"},

                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/nginx/v1.30", "desc" : "nginx, 1.3 업데이트"},
                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/perl"},
                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/mariadb/v11.3.2", "desc" : "mariadb 11.3 업데이트"},

                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/zip"},
                        {"use": true, "rpm_directory": "{package_root}/extension/rpm-install/extra-repo/squid_proxy", "desc" : "proxy 서버"}
                    
                    ],

                    "custom_create_repo_list":
                    [                        
                        "{package_root}/extension/rpm-install/createrepo/createrepo_c-libs-0.20.1-4.el9.x86_64.rpm",
                        "{package_root}/extension/rpm-install/createrepo/createrepo_c-0.20.1-4.el9.x86_64.rpm"
                    ]
                },

                "dnf_local_install":
                {
                    "dnf_install_cmd_format" : "dnf install {rpm} --disablerepo=\"*\" --enablerepo=\"aivax-repo\" -y -q",
                    "dnf_remove_cmd_format" : "dnf remove {rpm} -y -q",

                    "dnf_install_cmd_format_list" : [
                        "dnf",                        
                        "install",
                        "{package}",
                        "--disablerepo=*",
                        "--enablerepo=aivax-repo",
                        "-y",
                        "-q"                        
                    ],

                    "dnf_remove_cmd_format_list" : [
                        "dnf",
                        "remove",
                        "{package}",
                        "-y",
                        "-q"
                    ],

                    "rpm_pre_clear_list":
                    [
                        "nginx", 
                        "nginx-core", 
                        "nginx-filesystem"
                    ],

                    "rpm_list": [
                        "jq",
                        "libreoffice*",
                        "tesseract",
                        "tesseract-langpack-kor",
                        "MariaDB-server",
                        "MariaDB-client",
                        "libpcap",
                        "nginx",
                        "zip",
                        "unzip",
                        "squid",
                        "cmake"
                    ]
                }

            },

            "ext3rd_opensource_install":
            {
                "fluent_bit_install":
                {

                    "fluent_bit_bin_install":
                    {
                        "aivax_source" : "{package_root}/extension/fluent-bit/",
                        "dest_install_dir" : "{aivax_install_root}/fluent-bit/"
                    },

                    "aivax_fluent_bit_install_directory_list": 
                    [
                        {"use":true, "aivax_directory": "{aivax_install_root}/fluent-bit/db", "desc": "fluent-bit 이력db 저장경로"},
                        {"use":true, "aivax_directory": "{aivax_install_root}/fluent-bit/trace_log", "desc": "fluent-bit tracelog"}
                    ],

                    "customize_fluent_install_command":
                    [
                        ["chmod", "755", "{aivax_install_root}/fluent-bit/fluent-bit"]
                    ],

                    "fluent_bit_service_install":
                    {
                        "package_service_config_file" : "{package_root}/extension/fluent-bit/fluent-bit.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    }                    
                },

                "mariadb_install":
                {
                    "comment" : "db의 conf, 패스워드 설정에 대한 로직 개발 필요.",

                    "mariadb_cnf_path" : "/etc/my.cnf.d/custom.cnf"
                },

                "nginx_install":
                {
                    "comment" : "nginx 시스템 기동, nginx -t 이하 상세 설정은 시작+테스트 시점에 보강, 여기서는 복사만 담당",
                    "nginx_config_install_list":
                    [
                        {"use": true, "aivax_source": "{package_root}/data-setup/nginx-setup/nginx-conf/aivax.conf", "dest_install_dir": "/etc/nginx/conf.d/"},
                        {"use": true, "aivax_source": "{package_root}/data-setup/nginx-setup/nginx-conf/ssl", "dest_install_dir": "/etc/nginx/"}
                    ]

                },

                "nodejs_install":
                {
                    "nodejs_bin_install":
                    {
                        "aivax_source" : "{package_root}/extension/nodejs-install/node",
                        "dest_install_dir" : "{aivax_install_root}/extension"
                    },

                    "customize_nodejs_install_command":
                    [
                        ["chmod", "755", "{aivax_install_root}/extension/node"]
                    ]
                },

                "squid_proxy_install":
                {
                    "comment" : "squid config의 관리, proxy 옵션을 받아서 설치후 사용여부 지정 필요, 일단 설치까지는 진행",

                    "squid_proxy_config_install":
                    {
                        "aivax_source" : "{package_root}/data-setup/squid-setup/squid.conf",
                        "dest_install_dir" : "/etc/squid/"
                    }
                    
                },

                "opensearch_install":
                {

                    "customize_nodejs_install_command":
                    [
                        ["dnf", "install", "./extension/rpm-install/3rd-repo/opensearch/v3.3.2/opensearch-3.3.2-linux-x64.rpm", "-y", "-q"]
                    ]
                }
            },

            "slm_install":
            {

            },

            "aivax_source_patch_install":
            {
                "aivax_venv_setup":
                {
                    "venv_root" : "/home1/aivax/aivax-venv",
                    "uv_path" : "/usr/local/bin/uv",
                    "python_path" : "global_env에서 가져온다.",

                    "python_whl_package_path" : "{package_root}/extension/python-install",

                    "uv_pip_install_command" : [
                        "uv", "--quiet", "pip", "install", 
                        "--no-index", "--find-links={package_root}/extension/python-install/offline-wheel/",
                        "-r", "{package_root}/extension/python-install/aivax-requirement.txt"
                    ],

                    "pycomlib_install":
                    {
                        "comment" : "경로변경 이슈, 경로 변경에 주의",
                        "pycom_install_command": [
                            "uv", "--quiet", "pip", "install", "{package_root}/offline-wheel/{package}",
                            "--force-reinstall"
                        ],

                        "pycomlib_package":
                        [
                            {"use": true, "package": "{package_root}/extension/python-install/offline-wheel/pycomlib-1.1.7-py3-none-any.whl", "desc":""},
                            {"use": true, "package": "{package_root}/extension/python-install/offline-wheel/pycomlibex-1.1.2-py3-none-any.whl", "desc":""},
                            {"use": true, "package": "{package_root}/extension/python-install/offline-wheel/pyservice-1.0.3-py3-none-any.whl", "desc":""},
                            {"use": true, "package": "{package_root}/extension/python-install/offline-wheel/pytoolkit-1.0.0-py3-none-any.whl", "desc":""}
                        ]
                    }
                },

                "pipeline_patch_install":
                {
                    "package_tar_gzip_path" : "{package_root}/aivax-patch/pipeline.tar.gz",
                    "tar_dest_dir" : "pipeline",

                    "service_install":
                    {
                        "package_service_config_file" : "{package_root}/aivax-patch/systemd/pipeline-install/aivax-pipeline.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    },

                    "customize_command": [
                        {"desc" : "공통 실행후,부가적으로 수행이 필요한 경우 subprocess 활용"}
                    ]
                },

                "toolkit_patch_install":
                {
                    "package_tar_gzip_path" : "{package_root}/aivax-patch/toolkit.tar.gz",
                    "tar_dest_dir" : "toolkit", 

                    "service_install":
                    {
                        "package_service_config_file" : "{package_root}/aivax-patch/systemd/toolkit-install/aivax-toolkit.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    }
                },

                "management_patch_install":
                {
                    "package_tar_gzip_path" : "{package_root}/aivax-patch/management.tar.gz",
                    "tar_dest_dir" : "management", 

                    "service_install":
                    {
                        "package_service_config_file" : "{package_root}/aivax-patch/systemd/management-install/aivax-management.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    }
                },

                "sslproxy_patch_install":
                {
                    "desc" : "TODO: 이 시점부터는 사양이 변경되었다. 그 쓰레기 소스 확인 필요",

                    "package_tar_gzip_path" : "{package_root}/aivax-patch/sslproxy.tar.gz",
                    "tar_dest_dir" : "sslproxy", 

                    "service_install":
                    {
                        "package_service_config_file" : "{package_root}/aivax-patch/systemd/sslproxy-install/aivax-sslproxy.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    }

                },

                "ai_engine_patch_install":
                {
                    "desc" : "TODO: 이 시점부터는 사양이 변경되었다. 그 쓰레기 소스 확인 필요",

                    "package_tar_gzip_path" : "{package_root}/aivax-patch/ai_engine.tar.gz",
                    "tar_dest_dir" : "ai_engine", 

                    "service_install":
                    {
                        "package_service_config_file" : "{package_root}/aivax-patch/systemd/ai-engine-install/ai-engine.service",
                        "dest_install_dir" : "/etc/systemd/system/"
                    }
                },

                "mariadb_migrate":
                {
                    "desc" : 
                    [
                        "management에서 db테이블, 로그를 설정하는 구조를 변경하고, 다시 구현",
                        "1차 그대로 반영후, 쓰레기 코드 제거",
                        "기존의 쓰레기 코드는 쉘스크립트로 호출후, 검증 및 보강을 별도로 만든다.",
                        "이 기능은 start 모듈에서 처리하는 것도 고민한다. 최소 start 수행시 상태 검증이 되어야 한다."
                    ],

                    "customize_extern_shell_script": ""
                }
            }
            
        },

        "aivax_install_util_module":
        {
            "version_config":
            {

                "export_path" : "/home1/aivax",
                "version_file" : "version.json"
            }

        },

        "aivax_process":
        {
            "service_list": 
            [
                {"use" : true, "id" : "nginx", "service" : "nginx", "custom_run_call": "run_nginx", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "fluent-bit", "service" : "fluent-bit", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "opensearch", "service" : "opensearch", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "mariadb", "service" : "mariadb", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},

                {"use" : true, "id" : "management", "service" : "aivax-management", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "pipeline", "service" : "aivax-pipeline", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "sslproxy", "service" : "aivax-sslproxy", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},
                {"use" : true, "id" : "ai-engine", "service" : "ai-engine", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true},

                {"use" : true, "id" : "squid", "service" : "squid", "custom_run_call": "run_service", "custom_stop_call": "stop_service", "restart_flag" : true}
            ],

            "daemon_list" : 
            [
                {"use" : false, "id" : "slm-filter", "custom_run_call" : "start_slm", "custom_stop_call" : "", "restart_flag" : true},
                {"use" : false, "id" : "toolkit-scheduler.01", "custom_run_call" : "", "custom_stop_call" : "", "restart_flag" : true},
                {"use" : false, "id" : "aivax-guard", "custom_run_call" : "", "custom_stop_call" : "", "restart_flag" : true},
                {"use" : false, "id" : "toolkit-ui", "custom_run_call" : "", "custom_stop_call" : "", "restart_flag" : true}
            ],

            "slm_process_config":
            {
                "llama_bin_default_parameter":
                {
                    "slm_base_dir" : "slm",
                    "llama_bin_path" : "llama.cpp/build/bin/llama-server",
                    "model_sym_link" : "models/cipher-guard-current.gguf",

                    "thread_count" : 40,
                    "ctx_size" : 4096,
                    "temp" : 0.0,
                    "top_percent" : 1.0,
                    "repeat_penalty" : 1.1,
                    "gpu_layer" : 999,
                    "jinja" : "--jinja"
                }
            }
        },

