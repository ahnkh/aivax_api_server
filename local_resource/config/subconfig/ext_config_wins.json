        "env_default_path" : "/root/.aivenv",

        "default_auth_env":
        {

            "management":
            {
                "management_host" : "0.0.0.0",
                "management_port" : 3001
            },

            "pipeline":
            {
                "pipeline_host" : "127.0.0.1",
                "pipeline_port" : 9099
            },

            "slm":
            {
