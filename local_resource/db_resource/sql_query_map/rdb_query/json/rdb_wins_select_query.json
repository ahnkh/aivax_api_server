{
    "category" : "rdb",
    "connection_id" : "mariadb_connector",

    "desc" : [        
        
    ],

    "query_map":
    [

        {
            "desc" : "migration backup, 공통 쿼리",
            "key": "rdb_select_migrate_rdb",
	        "action" : "query_for_list",
            "query" : "SELECT * FROM {table}"
        },

        {
            "desc" : "migration backup, 테이블 존재 여부",
            "key": "rdb_select_migrate_table_exist",
	        "action" : "query_for_object",
            "query" : "SELECT COUNT(*) AS count FROM information_schema.tables WHERE table_schema = 'app' AND table_name = '{table}'"
        },

        {
            "desc" : "pipeline 정책, 테스트용 regex 정책의 조회",
            "key": "rdb_select_pipline_all_pattern_list",
	        "action" : "query_for_list",
            "query" : "SELECT id, name, type_mask, rule, regex_flag, regex_group, regex_group_val, action, status, category, category_id from app.policy_rules"
        },

        {
            "desc" : "admin 사용자 id 조회",
            "key": "rdb_select_admin_user_id",
	        "action" : "query_for_object",
            "query" : "select id from app.admin order by created_at limit 1"
        },

        {
            "desc" : "file 무결성 주기 조회",
            "key": "rdb_select_file_integrity_cycle",
	        "action" : "query_for_object",
            "query" : "select value from app.settings where `key` = 'file-integrity-check-cycle'"
        }
        
    ]
}

