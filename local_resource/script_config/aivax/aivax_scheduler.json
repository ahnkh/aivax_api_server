{
    "command_list":
    [
        {
            "desc" : "aivax scheduler 실행",
            "enable_command" : 1,
            "method" : ["manage_operation_util_modules"],
            "ext_module" : "manage_etc_util_module",
            "cmd_category" : "etc_util_module",
            "command" : "schedule_daemon",

            "schedule_list": [

                {"use":1, "interval":10, "schedule_unit":"minutes", "custom_kshell_command":"schedule_backup_aivax_etc_attach_file"},

                {"use":1, "interval":15, "schedule_unit":"minutes", "custom_kshell_command":"schedule_rotate_aivax_backup_disk"},

                {"use":1, "interval":0, "schedule_unit":"hours", "at_time": ":5", "custom_kshell_command":"schedule_backup_aivax_prompt_log"},
                
                {"use":1, "interval":0, "schedule_unit":"days", "at_time": "23:59", "custom_kshell_command":"schedule_snapshot_opensearch"}
                
            ]
        }
    ]
}