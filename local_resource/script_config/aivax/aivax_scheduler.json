{
    "command_list":
    [
        {
            "desc" : "aivax scheduler 실행",
            "enable_command" : 1,
            "method" : ["manage_operation_util_modules"],
            "ext_module" : "manage_etc_util_module",
            "cmd_category" : "etc_util_module",
            "command" : "schedule_daemon",

            "schedule_pre_init" :
            [
                {"use":true, "id": "pre init", "task_worker":"aivax_task", "method":"pre_custom_init_aivax", "parameter":""},
                {"use":false, "id": "백업 디스크 감시", "task_worker":"aivax_task", "method":"schedule_rotate_aivax_backup_disk", "parameter":""}
            ],

            "schedule_list": [
                
                {"use":true, "id": "aivax 첨부파일 백업 (10분)", "interval":10, "schedule_unit":"minutes", "task_worker":"etc_task", "method":"do_extern_command", "parameter":"ls -al"},

                {"use":true, "id": "프롬프트 로그 백업 (매시 5분)", "interval":0, "schedule_unit":"hours", "at_time": "05:00", "task_worker":"aivax_task", "method":"schedule_backup_aivax_prompt_log", "parameter":""},

                {"use":true, "id": "백업 디스크 감시 (매시 10분)", "interval":15, "schedule_unit":"hours", "at_time": "10:00", "task_worker":"aivax_task", "method":"schedule_rotate_aivax_backup_disk", "parameter":""},
                
                {"use":true, "id": "opensearch snapshot 백업 (매일 23:59)", "interval":0, "schedule_unit":"days", "at_time": "23:59", "task_worker":"aivax_task", "method":"schedule_snapshot_opensearch", "parameter":""}
                
            ]
        }
    ]
}